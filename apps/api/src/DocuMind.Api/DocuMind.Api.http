Content-Type: application/json

{
  "name": "Main Workspace"
}

###
# Get Workspace
#

@workspaceId = 68cb5109-125f-4f63-8be0-831311cdc7af

###
# Get Workspace

GET {{host}}/api/organizations/{{organizationId}}/workspaces/{{workspaceId}}
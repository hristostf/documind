# Create Organization
#

POST {{host}}/api/organizations
Content-Type: application/json

{
  "name": "   "
}

###
# Get Organization
#

@organizationId = 13b77ae9-2444-4779-a319-1bdefa31dff0

GET {{host}}/api/organizations/{{organizationId}}

###
# Create Workspace
#

